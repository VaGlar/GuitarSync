{
  "manifest_version": 3,
  "name": "GuitarSync",
  "version": "1.0.0",
  "description": "Βρες αυτόματα συγχορδίες & tabs για ό,τι παίζει στο Spotify",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GuitarSync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "identity",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://www.ultimate-guitar.com/*",
    "https://kithara.to/*",
    "https://html.duckduckgo.com/*"
  ]
}
